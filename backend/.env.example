# Copy this file to .env and replace every placeholder with your own values.
# Never commit .env or share real database credentials/JWT secrets.

NODE_ENV=development
GATEWAY_PORT=8080
JWT_SECRET=KASDJKALJDLKAJJFDIEJFJ982U983RU982H43RD2OIDKI32I498RU2R2R02IER8IU2FRHE24IR94U82R2JIRJ29RH29R

# Use a separate database name for each service, even when they share one MongoDB cluster.
# URL-encode special characters in usernames/passwords.
MONGO_URL_USERS=mongodb+srv://<username>:<password>@<cluster-host>/feiras_users?retryWrites=true&w=majority
MONGO_URL_MARKETS=mongodb+srv://<username>:<password>@<cluster-host>/feiras_markets?retryWrites=true&w=majority
MONGO_URL_RATINGS=mongodb+srv://<username>:<password>@<cluster-host>/feiras_ratings?retryWrites=true&w=majority
MONGO_URL_FAVORITES=mongodb+srv://<username>:<password>@<cluster-host>/feiras_favorites?retryWrites=true&w=majority
MONGO_URL_NOTIFICATIONS=mongodb+srv://<username>:<password>@<cluster-host>/feiras_notifications?retryWrites=true&w=majority
MONGO_URL_NOTES=mongodb+srv://<username>:<password>@<cluster-host>/feiras_notes?retryWrites=true&w=majority
